<?xml version="1.0" encoding="utf-8"?>
<!-- Écran pensé pour une TV : gros caractères, une seule colonne, lisible à 3 m -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Étape 1 : service d'accessibilité -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="1. Activer le service"
            android:textColor="#9FB3C8"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <!-- Android 13+ : appli installée depuis un APK → « Paramètre restreint ».
             Il faut d'abord l'autoriser depuis l'écran d'infos d'Android (menu ⋮). -->
        <Button
            android:id="@+id/openAppInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="a. Infos de l'appli (⋮ → Autoriser les paramètres restreints)"
            android:textSize="20sp" />

        <Button
            android:id="@+id/openSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="b. Ouvrir les réglages d'accessibilité"
            android:textSize="20sp" />

        <!-- Repli : débogage sans fil (ADB) si le menu ⋮ est introuvable -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Si le menu ⋮ est introuvable : débogage sans fil"
            android:textColor="#9FB3C8"
            android:textSize="18sp" />

        <Button
            android:id="@+id/openAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="c. À propos (7 appuis sur « Numéro de build »)"
            android:textSize="18sp" />

        <Button
            android:id="@+id/openDevOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="d. Options pour les développeurs"
            android:textSize="18sp" />

        <!-- Étape 2 : appairage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="2. Dans l'application du téléphone"
            android:textColor="#9FB3C8"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.2"
            android:textColor="#7CC4FF"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#9FB3C8"
            android:textSize="20sp" />

        <Button
            android:id="@+id/resetPairing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Oublier le téléphone appairé (nouveau code)"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
